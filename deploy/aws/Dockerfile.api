FROM python:3.12.2-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt && useradd --uid 10001 --create-home firecal
COPY --chown=10001:10001 backend/app ./app
COPY --chown=10001:10001 deploy/aws/bootstrap_database.py ./ops/bootstrap_database.py
USER 10001:10001
EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--root-path", "/api", "--workers", "1", "--limit-concurrency", "200", "--proxy-headers", "--forwarded-allow-ips", "*"]
